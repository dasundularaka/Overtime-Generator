rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Direct check for designated superadmin / bootstrap admin
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'qdGIZL4RtYeppzf8SYTcWN9zUkp1' ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'dasundularaka@gmail.com' ||
          request.auth.token.email.lower() == 'dasundularaka@gmail.com'
        ))
      );
    }

    // Check if the authenticated user has an 'admin' role
    function isAdmin() {
      return isSuperAdmin() ||
        (isSignedIn() && (
          (request.auth.token.role != null && request.auth.token.role == 'admin') ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        ));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Admins marker collection
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // User profiles & limits: accessible for corporate staff directory & PF login lookups
    match /users/{userId} {
      allow read, write: if true;
    }

    // Overtime claims: staff submissions and admin reviews
    match /claims/{claimId} {
      allow read, write: if true;
    }

    // Form templates: Allow full access for template designer and claim generation
    match /templates/{templateId} {
      allow read, write: if true;
    }

    // Holidays calendar collection: readable and writable
    match /holidays/{holidayId} {
      allow read, write: if true;
    }

    // PF Directory for authentication lookup: readable & writable for username/PF resolution
    match /pfDirectory/{pfNumber} {
      allow read, write: if true;
    }

    // Administrative audit logs: readable & writable
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // Branch network: readable and writable
    match /branches/{branchId} {
      allow read, write: if true;
    }

    // Roles and designations: readable and writable
    match /roles/{roleId} {
      allow read, write: if true;
    }

    // Departments: readable and writable
    match /departments/{departmentId} {
      allow read, write: if true;
    }
  }
}

