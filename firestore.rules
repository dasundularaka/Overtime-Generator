rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Direct check for designated superadmin / bootstrap admin
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'qdGIZL4RtYeppzf8SYTcWN9zUkp1' ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'dasundularaka@gmail.com' ||
          request.auth.token.email.lower() == 'dasundularaka@gmail.com'
        ))
      );
    }

    // Check if the authenticated user has an 'admin' role
    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        (request.auth.token.role != null && request.auth.token.role == 'admin') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
    }

    // Admins marker collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isAdmin();
    }

    // User profiles & limits
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isOwner(userId) || isAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
    }

    // Overtime claims
    match /claims/{claimId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Form templates: Allow authenticated users with 'admin' roles to perform write operations (create, update, delete)
    match /templates/{templateId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Holidays calendar collection: readable by all, writable by admins
    match /holidays/{holidayId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // PF Directory for authentication lookup: readable by all for username/PF resolution, writable by admins
    match /pfDirectory/{pfNumber} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
