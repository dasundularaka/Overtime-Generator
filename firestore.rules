rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Direct check for designated superadmin / bootstrap admin
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'qdGIZL4RtYeppzf8SYTcWN9zUkp1' ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'dasundularaka@gmail.com' ||
          request.auth.token.email.lower() == 'dasundularaka@gmail.com'
        ))
      );
    }

    // Check if the authenticated user has an 'admin' role
    function isAdmin() {
      return isSuperAdmin() ||
        (isSignedIn() && (
          (request.auth.token.role != null && request.auth.token.role == 'admin') ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        ));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Admins marker collection
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // User profiles & limits: accessible for corporate staff directory & PF login lookups
    match /users/{userId} {
      allow read, write: if true;
    }

    // Overtime claims: staff submissions and admin reviews
    match /claims/{claimId} {
      allow read, write: if true;
    }

    // Form templates: Allow full access for template designer and claim generation
    match /templates/{templateId} {
      allow read, write: if true;
    }

    // Holidays calendar collection: readable and writable
    match /holidays/{holidayId} {
      allow read, write: if true;
    }

    // PF Directory for authentication lookup: readable & writable for username/PF resolution
    match /pfDirectory/{pfNumber} {
      allow read, write: if true;
    }

    // Administrative audit logs: readable & writable
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // Branch network: readable and writable
    match /branches/{branchId} {
      allow read, write: if true;
    }

    // Roles and designations: readable and writable
    match /roles/{roleId} {
      allow read, write: if true;
    }

    // Departments: readable and writable
    match /departments/{departmentId} {
      allow read, write: if true;
    }

    // Holiday categories and display colors
    match /holidayCategories/{categoryId} {
      allow read, write: if true;
    }

    // Calendar display settings (e.g. first day of week)
    match /calendarSettings/{settingId} {
      allow read, write: if true;
    }

    function isValidConfigId(id) {
      return id is string && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidAppRelease(data) {
      return data.keys().hasAll(['id', 'version', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'version', 'buildTime', 'commitSha', 'releaseNotes',
          'forceImmediate', 'broadcastId', 'updatedAt', 'updatedBy'
        ])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 64
        && data.version is string && data.version.size() > 0 && data.version.size() <= 128
        && data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 64
        && (!('buildTime' in data) || (data.buildTime is string && data.buildTime.size() <= 64))
        && (!('commitSha' in data) || (data.commitSha is string && data.commitSha.size() <= 64))
        && (!('releaseNotes' in data) || (data.releaseNotes is string && data.releaseNotes.size() <= 300))
        && (!('forceImmediate' in data) || (data.forceImmediate is bool))
        && (!('broadcastId' in data) || (data.broadcastId is string && data.broadcastId.size() <= 64))
        && (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 120));
    }

    function isValidEmailActivitySettings(data) {
      return data.keys().hasAll([
          'id', 'loginAlerts', 'passwordChangeAlerts',
          'claimSubmissionAlerts', 'roleChangeAlerts', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'loginAlerts', 'passwordChangeAlerts',
          'claimSubmissionAlerts', 'roleChangeAlerts', 'updatedAt', 'updatedBy'
        ])
        && data.id == 'emailActivitySettings'
        && data.loginAlerts is bool
        && data.passwordChangeAlerts is bool
        && data.claimSubmissionAlerts is bool
        && data.roleChangeAlerts is bool
        && data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 64
        && (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 120));
    }

    // Global system metadata (OTA release signal & email activity toggles)
    match /systemConfig/{configId} {
      allow get: if isValidConfigId(configId);
      allow list: if false;
      allow create, update: if isValidConfigId(configId) && (
        (configId == 'emailActivitySettings' && isValidEmailActivitySettings(request.resource.data)) ||
        (configId != 'emailActivitySettings' && isValidAppRelease(request.resource.data))
      );
      allow delete: if false;
    }

    function isValidNotification(data) {
      return data.keys().hasAll([
          'id', 'heading', 'body', 'priority', 'targetScope',
          'targetUserIds', 'sendViaApp', 'sendViaEmail',
          'senderId', 'senderName', 'senderRole', 'senderBranch',
          'readBy', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'heading', 'body', 'priority', 'imageUrl',
          'targetScope', 'targetLabel', 'targetBranch', 'targetBranchCode',
          'targetUserIds', 'recipientCount', 'sendViaApp', 'sendViaEmail',
          'emailDispatchStatus', 'emailDispatchedCount',
          'senderId', 'senderName', 'senderEmail', 'senderRole', 'senderBranch',
          'readBy', 'readReceipts', 'createdAt'
        ])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.heading is string && data.heading.size() > 0 && data.heading.size() <= 160
        && data.body is string && data.body.size() > 0 && data.body.size() <= 4000
        && data.priority in ['high', 'medium', 'low']
        && data.targetScope in ['all', 'branch', 'users']
        && data.targetUserIds is list && data.targetUserIds.size() <= 1000
        && data.sendViaApp is bool
        && data.sendViaEmail is bool
        && data.senderId is string && data.senderId.size() > 0 && data.senderId.size() <= 128
        && data.senderName is string && data.senderName.size() > 0 && data.senderName.size() <= 120
        && data.senderRole in ['super_admin', 'admin', 'user']
        && data.senderBranch is string && data.senderBranch.size() <= 120
        && data.readBy is list && data.readBy.size() <= 1000
        && (!('readReceipts' in data) || (data.readReceipts is map && data.readReceipts.size() <= 1000))
        && data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 500000))
        && (!('targetLabel' in data) || (data.targetLabel is string && data.targetLabel.size() <= 200))
        && (!('targetBranch' in data) || (data.targetBranch is string && data.targetBranch.size() <= 120))
        && (!('targetBranchCode' in data) || (data.targetBranchCode is string && data.targetBranchCode.size() <= 40))
        && (!('recipientCount' in data) || (data.recipientCount is int || data.recipientCount is float))
        && (!('emailDispatchStatus' in data) || (data.emailDispatchStatus in ['not_requested', 'sent', 'partial', 'failed']))
        && (!('emailDispatchedCount' in data) || (data.emailDispatchedCount is int || data.emailDispatchedCount is float))
        && (!('senderEmail' in data) || (data.senderEmail is string && data.senderEmail.size() <= 160));
    }

    // Notifications collection: validated writes, read/update/delete supported for staff & admins
    match /notifications/{notificationId} {
      allow get, list: if true;
      allow create, update: if isValidConfigId(notificationId) && isValidNotification(request.resource.data);
      allow delete: if isValidConfigId(notificationId);
    }
  }
}

