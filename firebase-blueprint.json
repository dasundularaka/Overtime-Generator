{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile with role, overtime limits, and organizational metadata",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "enum": [
            "admin",
            "user"
          ]
        },
        "claimType": {
          "type": "string",
          "enum": [
            "OT",
            "OP"
          ]
        },
        "employeeNumber": {
          "type": "string",
          "maxLength": 50
        },
        "designation": {
          "type": "string",
          "maxLength": 100
        },
        "department": {
          "type": "string",
          "maxLength": 100
        },
        "branch": {
          "type": "string",
          "maxLength": 100
        },
        "maxOtHoursPerDay": {
          "type": "number"
        },
        "assignedTemplateIds": {
          "type": "array"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "defaultWeekdayReason": {
          "type": "string",
          "maxLength": 150
        },
        "defaultSaturdayReason": {
          "type": "string",
          "maxLength": 150
        },
        "defaultHolidayReason": {
          "type": "string",
          "maxLength": 150
        }
      },
      "required": [
        "id",
        "email",
        "name",
        "role",
        "claimType"
      ]
    },
    "Claim": {
      "title": "Overtime Claim",
      "description": "Monthly overtime claim record belonging to a specific user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "claimNumber": {
          "type": "string"
        },
        "employeeName": {
          "type": "string"
        },
        "employeeNumber": {
          "type": "string"
        },
        "designation": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "department": {
          "type": "string"
        },
        "claimType": {
          "type": "string",
          "enum": [
            "OT",
            "OP"
          ]
        },
        "month": {
          "type": "string"
        },
        "year": {
          "type": "number"
        },
        "claimDate": {
          "type": "string"
        },
        "rows": {
          "type": "array"
        },
        "totalMinutes": {
          "type": "number"
        },
        "totalHoursFormatted": {
          "type": "string"
        },
        "totalDecimalHours": {
          "type": "number"
        },
        "otDaysCount": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "submitted",
            "approved",
            "rejected",
            "completed"
          ]
        },
        "templateId": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "userId",
        "employeeName",
        "month",
        "year"
      ]
    },
    "Template": {
      "title": "Form Template",
      "description": "A4 Overtime Form Template overlay coordinates and settings",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "isDefault": {
          "type": "boolean"
        },
        "pageSize": {
          "type": "string"
        },
        "widthMm": {
          "type": "number"
        },
        "heightMm": {
          "type": "number"
        },
        "backgroundImageUrl": {
          "type": "string"
        },
        "backgroundType": {
          "type": "string",
          "enum": [
            "image",
            "pdf"
          ]
        },
        "fields": {
          "type": "array"
        },
        "tableConfig": {
          "type": "object"
        },
        "printerOffsetX": {
          "type": "number"
        },
        "printerOffsetY": {
          "type": "number"
        },
        "createdBy": {
          "type": "string"
        },
        "createdByName": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "Holiday": {
      "title": "Holiday",
      "description": "Company, bank, and public holidays calendar entry",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "public",
            "bank",
            "mercantile",
            "special"
          ]
        },
        "description": {
          "type": "string"
        },
        "isRecurringYearly": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "date",
        "name",
        "type"
      ]
    },
    "PfDirectory": {
      "title": "PF Directory",
      "description": "Directory mapping PF numbers to user email and account identity",
      "type": "object",
      "properties": {
        "pfNumber": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        }
      },
      "required": [
        "pfNumber",
        "email"
      ]
    },
    "HolidayCategory": {
      "title": "Holiday Category",
      "description": "Configurable holiday category and color token managed by Super Admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "shortName": { "type": "string" },
        "color": { "type": "string" },
        "isDefault": { "type": "boolean" },
        "order": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "color"]
    },
    "CalendarSettings": {
      "title": "Calendar Settings",
      "description": "Global calendar display configuration managed by Super Admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "firstDayOfWeek": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "firstDayOfWeek"]
    },
    "AppRelease": {
      "title": "OTA App Release Signal",
      "description": "Latest deployed Vercel build metadata used to push instant over-the-air updates to connected browser tabs",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "version": { "type": "string", "maxLength": 128 },
        "buildTime": { "type": "string", "maxLength": 64 },
        "commitSha": { "type": "string", "maxLength": 64 },
        "releaseNotes": { "type": "string", "maxLength": 300 },
        "forceImmediate": { "type": "boolean" },
        "broadcastId": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "updatedBy": { "type": "string", "maxLength": 120 }
      },
      "required": ["id", "version", "updatedAt"]
    },
    "EmailActivitySettings": {
      "title": "Email Activity Notification Settings",
      "description": "Global toggles controlling automatic Make webhook activity emails for logins, password changes, claim submissions, and role updates",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "loginAlerts": { "type": "boolean" },
        "passwordChangeAlerts": { "type": "boolean" },
        "claimSubmissionAlerts": { "type": "boolean" },
        "roleChangeAlerts": { "type": "boolean" },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "updatedBy": { "type": "string", "maxLength": 120 }
      },
      "required": [
        "id",
        "loginAlerts",
        "passwordChangeAlerts",
        "claimSubmissionAlerts",
        "roleChangeAlerts",
        "updatedAt"
      ]
    },
    "Notification": {
      "title": "System Notification",
      "description": "Targeted notification broadcast by Super Admin or Branch Admin via in-app push and optional email",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "heading": { "type": "string", "maxLength": 160 },
        "body": { "type": "string", "maxLength": 4000 },
        "priority": { "type": "string", "enum": ["high", "medium", "low"] },
        "imageUrl": { "type": "string", "maxLength": 500000 },
        "targetScope": { "type": "string", "enum": ["all", "branch", "users"] },
        "targetLabel": { "type": "string", "maxLength": 200 },
        "targetBranch": { "type": "string", "maxLength": 120 },
        "targetBranchCode": { "type": "string", "maxLength": 40 },
        "targetUserIds": { "type": "array" },
        "recipientCount": { "type": "number" },
        "sendViaApp": { "type": "boolean" },
        "sendViaEmail": { "type": "boolean" },
        "emailDispatchStatus": { "type": "string", "enum": ["not_requested", "sent", "partial", "failed"] },
        "emailDispatchedCount": { "type": "number" },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 120 },
        "senderEmail": { "type": "string", "maxLength": 160 },
        "senderRole": { "type": "string", "enum": ["super_admin", "admin", "user"] },
        "senderBranch": { "type": "string", "maxLength": 120 },
        "readBy": { "type": "array" },
        "readReceipts": { "type": "object" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": [
        "id",
        "heading",
        "body",
        "priority",
        "targetScope",
        "targetUserIds",
        "sendViaApp",
        "sendViaEmail",
        "senderId",
        "senderName",
        "senderRole",
        "senderBranch",
        "readBy",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "User profiles with roles, claim types, and overtime caps"
    },
    "/claims/{claimId}": {
      "schema": {
        "$ref": "#/entities/Claim"
      },
      "description": "Individual overtime claims submitted by users"
    },
    "/templates/{templateId}": {
      "schema": {
        "$ref": "#/entities/Template"
      },
      "description": "Form layout templates configurable only by administrators"
    },
    "/admins/{adminId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Marker collection denoting administrator access"
    },
    "/holidays/{holidayId}": {
      "schema": {
        "$ref": "#/entities/Holiday"
      },
      "description": "Official company and public holidays"
    },
    "/pfDirectory/{pfNumber}": {
      "schema": {
        "$ref": "#/entities/PfDirectory"
      },
      "description": "PF Number lookup directory for user sign in"
    },
    "/holidayCategories/{categoryId}": {
      "schema": {
        "$ref": "#/entities/HolidayCategory"
      },
      "description": "Configurable holiday categories and colors"
    },
    "/calendarSettings/{settingId}": {
      "schema": {
        "$ref": "#/entities/CalendarSettings"
      },
      "description": "Global calendar display settings such as first day of week"
    },
    "/systemConfig/{configId}": {
      "schema": {
        "$ref": "#/entities/AppRelease"
      },
      "description": "Global system metadata documents including OTA release version signals and emailActivitySettings notification preferences"
    },
    "/notifications/{notificationId}": {
      "schema": {
        "$ref": "#/entities/Notification"
      },
      "description": "Branch-scoped and organization-wide notifications sent by Super Admins and Branch Admins"
    }
  }
}